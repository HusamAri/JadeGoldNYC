# ------------------------------------------------------------------
# Jade Gold NYC — Yönetim Paneli ortam değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayın ve değerleri doldurun.
# ------------------------------------------------------------------

# Supabase (proje oluşturulduktan sonra doldurulur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # yalnız sunucu tarafı: sync, callback, RPC

# Uygulama
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Etsy Open API v3 (developers.etsy.com'da uygulama kaydı sonrası)
ETSY_API_KEY=                         # keystring (OAuth client_id)
ETSY_API_SECRET=                      # shared secret — API'de x-api-key: keystring:secret
ETSY_OAUTH_REDIRECT_URI=http://localhost:3000/api/etsy/callback
ETSY_SCOPES=shops_r transactions_r listings_r email_r feedback_r   # shops_r: shop_id/mağaza; feedback_r: yorumlar

# Shopify (Partner app — yeni marka / ikinci kanal). Yoksa Ayarlar → Shopify inert.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_OAUTH_REDIRECT_URI=http://localhost:3000/api/shopify/callback
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_inventory

# Cron koruması (Vercel Cron -> /api/cron/etsy-sync)
CRON_SECRET=

# AI — öncelik: Gemini (ücretsiz kota) → Vercel AI Gateway. bkz. docs/ai-gateway.md
# SEO Yardımcısı anahtarsız çalışır; Yorum AI + Anahtar Kelime AI genişletme bunlara bağlı.
GOOGLE_GENERATIVE_AI_API_KEY=         # aistudio.google.com — önerilen
# GEMINI_API_KEY=                     # alternatif isim (aynı anahtar)
AI_GATEWAY_API_KEY=                   # local; Vercel'de VERCEL_OIDC_TOKEN otomatik
AI_MODEL=gemini-2.5-flash             # Gemini yolunda model kimliği; gateway'de provider/model

# Opsiyonel talep hacmi (Anahtar Kelime) — yoksa inert
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
