# ------------------------------------------------------------------
# Jade Gold NYC — Yönetim Paneli ortam değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayın ve değerleri doldurun.
# ------------------------------------------------------------------

# Supabase (proje oluşturulduktan sonra doldurulur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # yalnız sunucu tarafı: sync, callback, RPC

# Uygulama
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Etsy Open API v3 (developers.etsy.com'da uygulama kaydı sonrası)
ETSY_API_KEY=                         # keystring (OAuth client_id)
ETSY_API_SECRET=                      # shared secret — API'de x-api-key: keystring:secret
ETSY_OAUTH_REDIRECT_URI=http://localhost:3000/api/etsy/callback
ETSY_SCOPES=shops_r transactions_r listings_r email_r feedback_r   # shops_r: shop_id/mağaza; feedback_r: yorumlar

# Cron koruması (Vercel Cron -> /api/cron/etsy-sync)
CRON_SECRET=

# AI — bkz. docs/ai-gateway.md ve docs/seo-api-kurulum.md
# Öncelik 1: Gemini (ücretsiz) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Öncelik 2: Vercel AI Gateway — local anahtar; Vercel'de OIDC otomatik gelir.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.6   # opsiyonel: varsayılan modeli değiştir

# DataForSEO — gerçek arama hacmi (Anahtar Kelime sayfası)
# Hesap: https://dataforseo.com/ → API Access: https://app.dataforseo.com/api-access
# DATAFORSEO_PASSWORD = API password (dashboard giriş şifren DEĞİL)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
